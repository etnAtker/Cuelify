<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Cuelify.Desktop.ViewModels" xmlns:views="using:Cuelify.Desktop.Views" xmlns:translation="using:Cuelify.Core.Translation" x:Class="Cuelify.Desktop.Views.SettingsView" x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="32,24">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="6">
        <TextBlock Classes="title" Text="设置" />
        <TextBlock Classes="muted" Text="{Binding SettingsHint}" />
      </StackPanel>
      <Button Grid.Column="1" Content="返回工作台" Command="{Binding ShowWorkspaceCommand}" VerticalAlignment="Center" />
    </Grid>
    <TextBlock Grid.Row="1" Classes="error" Text="{Binding Error}" Margin="0,12,0,0" />
    <TabControl Grid.Row="2" SelectedIndex="{Binding SettingsSectionIndex}" Margin="0,20,0,20">
      <TabItem Header="语音识别">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Classes="settings-form" Spacing="10" IsEnabled="{Binding CanConfigure}">
            <views:CredentialStatusView />
            <TextBlock Text="ElevenLabs API 密钥" />
            <TextBox AutomationProperties.Name="ElevenLabs API 密钥" Text="{Binding ElevenLabsKey}" PasswordChar="●" IsEnabled="{Binding CanEditCredentials}" MaxLength="4096" />
            <TextBlock Classes="muted" Text="音频将上传至 ElevenLabs 识别，可能产生费用。密钥通过主密码加密保存。" />
            <Expander Header="识别与音频高级参数">
              <StackPanel Spacing="8">
                <TextBlock Text="语音识别模型" />
                <TextBox Text="{Binding Settings.AsrModel}" AutomationProperties.Name="语音识别模型" />
                <TextBlock Text="FFmpeg 路径" />
                <TextBox Text="{Binding Settings.FfmpegPath}" AutomationProperties.Name="FFmpeg 路径" />
                <TextBlock Text="ffprobe 路径" />
                <TextBox Text="{Binding Settings.FfprobePath}" AutomationProperties.Name="ffprobe 路径" />
                <TextBlock Text="Silero ONNX 路径" />
                <TextBox Text="{Binding Settings.VadPath}" AutomationProperties.Name="Silero ONNX 路径" />
                <TextBlock Text="目标分片时长 / 秒" />
                <NumericUpDown Value="{Binding Settings.ChunkTargetSeconds}" Minimum="1" Maximum="3600" AutomationProperties.Name="目标分片时长 / 秒" />
                <TextBlock Text="最大分片时长 / 秒" />
                <NumericUpDown Value="{Binding Settings.ChunkMaximumSeconds}" Minimum="1" Maximum="36000" AutomationProperties.Name="最大分片时长 / 秒" />
                <TextBlock Text="切点前后搜索时长 / 秒" />
                <NumericUpDown Value="{Binding Settings.ChunkSearchSeconds}" Minimum="0" Maximum="300" AutomationProperties.Name="切点前后搜索时长 / 秒" />
                <TextBlock Text="音频片段重叠时长 / 毫秒" />
                <NumericUpDown Value="{Binding Settings.OverlapMs}" Minimum="0" Maximum="1000" AutomationProperties.Name="音频片段重叠时长 / 毫秒" />
                <TextBlock Text="零时长字幕合并间隔 / 毫秒" />
                <NumericUpDown Value="{Binding Settings.ZeroDurationToleranceMs}" Minimum="1" Maximum="7000" Increment="100" AutomationProperties.Name="零时长字幕合并间隔 / 毫秒" />
                <TextBlock Classes="muted" Text="在此间隔内与相邻文本合并；没有相邻文本时，以此时长单独显示。" />
                <TextBlock Text="语音检测阈值" />
                <NumericUpDown Value="{Binding Settings.VadThreshold}" Minimum="0.01" Maximum="1" Increment="0.05" AutomationProperties.Name="语音检测阈值" />
                <TextBlock Text="最短语音 / 毫秒" />
                <NumericUpDown Value="{Binding Settings.MinimumSpeechMs}" Minimum="1" Maximum="3000" AutomationProperties.Name="最短语音 / 毫秒" />
                <TextBlock Text="最短静音 / 毫秒" />
                <NumericUpDown Value="{Binding Settings.MinimumSilenceMs}" Minimum="0" Maximum="3000" AutomationProperties.Name="最短静音 / 毫秒" />
                <TextBlock Text="同时识别的片段数" />
                <NumericUpDown Value="{Binding Settings.AsrConcurrency}" Minimum="1" Maximum="8" AutomationProperties.Name="同时识别的片段数" />
                <TextBlock Text="单个音频上传上限 / 字节" />
                <NumericUpDown Value="{Binding Settings.MaximumUploadBytes}" Minimum="100000" Maximum="2900000000" AutomationProperties.Name="单个音频上传上限 / 字节" />
                <CheckBox Content="短音频也分片处理" IsChecked="{Binding Settings.AlwaysChunk}" />
              </StackPanel>
            </Expander>

          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="翻译服务">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Classes="settings-form" Spacing="10" IsEnabled="{Binding CanConfigure}">
            <TextBlock Text="翻译引擎" />
            <ComboBox AutomationProperties.Name="翻译引擎" ItemsSource="{Binding ProviderNames}" SelectedIndex="{Binding ProviderIndex}" HorizontalAlignment="Stretch" />
            <StackPanel Spacing="8" IsVisible="{Binding IsCloud}">
              <views:CredentialStatusView />
              <TextBlock Text="翻译服务 API 密钥" />
              <TextBox Text="{Binding TranslationKey}" PasswordChar="●" IsEnabled="{Binding CanEditCredentials}" MaxLength="4096" AutomationProperties.Name="翻译服务 API 密钥" />
              <TextBlock Classes="muted" Text="密钥通过主密码加密保存。" />
              <TextBlock Text="服务地址（Base URL）" />
              <TextBox Text="{Binding Settings.BaseUrl}" AutomationProperties.Name="服务地址（Base URL）" />
              <StackPanel Spacing="8" IsVisible="{Binding NeedsAddressConfirmation}">
                <TextBlock Classes="muted" Text="服务地址已变化，请确认已有密钥可用于新地址。" TextWrapping="Wrap" />
                <Button Content="确认密钥用于此地址" Command="{Binding ConfirmCompatibleAddressCommand}" />
              </StackPanel>
              <TextBlock Text="模型名称" />
              <TextBox Text="{Binding Settings.CloudModel}" AutomationProperties.Name="模型名称" />
              <StackPanel IsVisible="{Binding IsDeepSeek}" Spacing="8">
                <CheckBox Content="启用思考模式" IsChecked="{Binding Settings.ThinkingEnabled}" />
                <TextBlock Text="思考强度" />
                <ComboBox ItemsSource="{Binding EffortNames}" SelectedIndex="{Binding ThinkingEffortIndex}" IsEnabled="{Binding Settings.ThinkingEnabled}" AutomationProperties.Name="思考强度" />
                <TextBlock Classes="muted" Text="思考模式下，部分生成参数不可用。" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="8" IsVisible="{Binding IsLocal}">
              <TextBlock Text="llama.cpp 运行程序" />
              <TextBox x:Name="LlamaServerPath" Text="{Binding Settings.LlamaServerPath}" AutomationProperties.Name="llama-server 程序路径" />
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button x:Name="DownloadLlamaButton" Content="下载 llama.cpp" Command="{Binding DownloadLlamaCommand}" />
                <Button x:Name="ChooseLlamaServerButton" Content="选择运行程序" Command="{Binding ChooseLlamaServerCommand}" />
              </WrapPanel>
              <TextBlock Classes="muted" Text="下载官方 Windows x64 Vulkan 运行包，解压到设置文件夹中的 llama.cpp/。也可选择完整运行包中的 llama-server.exe。" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{Binding LlamaRuntimeStatus}" TextWrapping="Wrap" />
              <ProgressBar x:Name="LlamaInstallProgress" IsVisible="{Binding IsLlamaInstalling}" IsIndeterminate="{Binding LlamaInstallIndeterminate}" Value="{Binding LlamaInstallPercent}" Minimum="0" Maximum="100" />
              <TextBlock Classes="muted" Text="{Binding LlamaInstallStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="本地模型" />
              <ComboBox x:Name="EmbeddedModelSelector" ItemsSource="{Binding EmbeddedModels}" SelectedItem="{Binding SelectedEmbeddedModel}" HorizontalAlignment="Stretch" AutomationProperties.Name="本地模型" />
              <TextBlock Classes="muted" Text="需要支持 Vulkan 的显卡。模型越大，所需显存和下载空间通常越多。" />
              <Button x:Name="DownloadModelButton" Content="下载模型" Command="{Binding DownloadModelCommand}" />
              <Button Content="选择模型文件…" Command="{Binding ChooseModelCommand}" />
              <TextBlock Classes="muted" Text="下载的模型存放在配置文件所在文件夹，可取消并继续下载。" />
              <TextBlock Classes="muted" Text="{Binding ModelFileStatus}" />
              <ProgressBar x:Name="ModelDownloadProgress" IsVisible="{Binding IsModelDownloading}" IsIndeterminate="{Binding ModelDownloadIndeterminate}" Value="{Binding ModelDownloadPercent}" Minimum="0" Maximum="100" />
              <TextBlock Classes="muted" Text="{Binding ModelDownloadStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="模型文件路径" />
              <TextBox Text="{Binding Settings.ModelPath}" AutomationProperties.Name="模型文件路径" />
            </StackPanel>
            <TextBlock Text="关联提示词" />
            <ComboBox x:Name="AssociatedPromptSelector" ItemsSource="{Binding PromptItems}" SelectedItem="{Binding AssociatedPrompt}" HorizontalAlignment="Stretch" AutomationProperties.Name="模型关联提示词" />
            <Button Content="查看模板" Command="{Binding ViewAssociatedPromptCommand}" />
            <TextBlock Classes="section" Text="推理参数" Margin="0,8,0,0" />
            <TextBlock Text="并发请求数" />
            <NumericUpDown x:Name="InferenceConcurrency" Value="{Binding InferenceConcurrency}" Minimum="1" Maximum="8" FormatString="0" ParsingNumberStyle="Integer" AutomationProperties.Name="并发请求数" AutomationProperties.HelpText="{Binding ConcurrencyHint}" />
            <TextBlock Classes="muted" Text="{Binding ConcurrencyHint}" TextWrapping="Wrap" />
            <TextBlock Text="单次请求超时（秒）" />
            <NumericUpDown Value="{Binding Settings.TimeoutSeconds}" Minimum="1" Maximum="600" FormatString="0" ParsingNumberStyle="Integer" AutomationProperties.Name="单次请求超时（秒）" AutomationProperties.HelpText="{Binding TimeoutHint}" />
            <TextBlock Classes="muted" Text="{Binding TimeoutHint}" TextWrapping="Wrap" />
            <TextBlock Text="最大输出长度（token）" />
            <NumericUpDown x:Name="LocalOutputTokens" IsVisible="{Binding IsLocal}" Value="{Binding Settings.LocalMaximumTokens}" Minimum="1" Maximum="{Binding LocalOutputTokenMaximum}" FormatString="0" ParsingNumberStyle="Integer" AutomationProperties.Name="最大输出长度（token）" AutomationProperties.HelpText="{Binding OutputTokensHint}" />
            <NumericUpDown x:Name="CloudOutputTokens" IsVisible="{Binding IsCloud}" Value="{Binding CloudOutputTokens}" Minimum="1" Maximum="2147483647" FormatString="0" ParsingNumberStyle="Integer" Watermark="使用服务默认值" AutomationProperties.Name="最大输出长度（token）" AutomationProperties.HelpText="{Binding OutputTokensHint}" />
            <TextBlock Classes="muted" Text="{Binding OutputTokensHint}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding EngineCredentialHint}" TextWrapping="Wrap" />
            <Button Content="{Binding TestEngineButtonText}" Command="{Binding TestEngineCommand}" />
            <TextBlock Classes="muted" Text="{Binding EngineStatus}" />
            <TextBlock Classes="muted" Text="{Binding EngineTestHint}" />
            <Expander Header="翻译高级参数">
              <StackPanel Spacing="8">
                <TextBlock Text="译文风格" />
                <TextBox Text="{Binding Settings.TargetStyle}" AutomationProperties.Name="译文风格" />
                <TextBlock Text="最多请求次数（含首次请求）" />
                <NumericUpDown Value="{Binding Settings.MaximumAttempts}" Minimum="1" Maximum="5" AutomationProperties.Name="最多请求次数（含首次请求）" />
                <TextBlock Classes="muted" Text="失败后的重试计入次数；批量译文不完整时可能拆分补翻。" TextWrapping="Wrap" />
                <TextBlock Text="参考前文条数" />
                <NumericUpDown Value="{Binding Settings.ContextCues}" Minimum="0" Maximum="8" AutomationProperties.Name="参考前文条数" />
                <TextBlock Text="参考后文条数" />
                <NumericUpDown Value="{Binding Settings.FollowingContextCues}" Minimum="0" Maximum="8" AutomationProperties.Name="参考后文条数" />
                <TextBlock Text="参考上下文字符上限" />
                <NumericUpDown Value="{Binding Settings.MaximumContextCharacters}" Minimum="0" Maximum="20000" AutomationProperties.Name="参考上下文字符上限" />
                <StackPanel IsVisible="{Binding IsLocal}" Spacing="8">
                  <TextBlock Text="模型上下文容量（token）" />
                  <NumericUpDown x:Name="LocalContextSize" Value="{Binding Settings.ContextSize}" Minimum="512" Maximum="32768" Increment="512" AutomationProperties.Name="模型上下文容量（token）" />
                  <TextBlock Classes="muted" Text="每个请求单独计算，包含提示词、参考上下文和输出。提高容量会增加显存占用。" TextWrapping="Wrap" />
                  <TextBlock Text="GPU 卸载层数" />
                  <NumericUpDown Value="{Binding Settings.GpuLayers}" Minimum="1" Maximum="99" AutomationProperties.Name="GPU 卸载层数" />
                </StackPanel>
                <StackPanel IsVisible="{Binding IsCloud}" Spacing="8">
                  <TextBlock Classes="muted" Text="可选参数留空时使用服务默认值。" />
                  <StackPanel IsEnabled="{Binding CanEditSampling}" Spacing="8">
                    <TextBlock Text="温度（temperature）" />
                    <TextBox Text="{Binding Settings.Temperature}" AutomationProperties.Name="温度（temperature）" />
                    <TextBlock Text="重复惩罚（frequency_penalty）" />
                    <TextBox Text="{Binding Settings.FrequencyPenalty}" AutomationProperties.Name="重复惩罚（frequency_penalty）" />
                    <TextBlock Text="新词倾向（presence_penalty）" />
                    <TextBox Text="{Binding Settings.PresencePenalty}" AutomationProperties.Name="新词倾向（presence_penalty）" />
                  </StackPanel>
                  <TextBlock Text="采样范围（top_p）" />
                  <TextBlock Classes="muted" Text="{Binding TopPHint}" />
                  <TextBox Text="{Binding Settings.TopP}" IsEnabled="{Binding CanEditTopP}" AutomationProperties.Name="采样范围（top_p）" />
                  <StackPanel IsVisible="{Binding IsCompatible}" Spacing="8">
                    <TextBlock Text="思考参数类型" />
                    <ComboBox ItemsSource="{Binding ReasoningCapabilityNames}" SelectedIndex="{Binding ReasoningCapabilityIndex}" AutomationProperties.Name="思考参数类型" />
                    <TextBlock Text="思考强度（reasoning_effort）" />
                    <TextBlock Classes="muted" Text="仅适用于支持该参数的服务和模型。" />
                    <TextBox Text="{Binding Settings.ReasoningEffort}" AutomationProperties.Name="思考强度（reasoning_effort）" />
                  </StackPanel>
                  <TextBlock Text="自定义请求参数（JSON）" />
                  <TextBox Text="{Binding Settings.AdvancedJson}" AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap" AutomationProperties.Name="自定义请求参数（JSON）" />
                </StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="提示词">
        <Grid ColumnDefinitions="200,*" IsEnabled="{Binding CanConfigure}">
          <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,0,16,0">
            <TextBox x:Name="PromptSearchBox" Text="{Binding PromptSearch}" Watermark="搜索模板" AutomationProperties.Name="搜索提示词模板" />
            <ComboBox Grid.Row="1" ItemsSource="{Binding PromptFilterNames}" SelectedIndex="{Binding PromptFilterIndex}" Margin="0,8" HorizontalAlignment="Stretch" AutomationProperties.Name="模板分类" />
            <Button Grid.Row="2" Content="新建提示词" Command="{Binding NewPromptCommand}" Margin="0,0,0,8" />
            <ListBox x:Name="PromptLibraryList" Grid.Row="3" ItemsSource="{Binding VisiblePromptItems}" SelectedItem="{Binding VisibleSelectedPrompt}" SelectionChanged="OnPromptSelectionChanged" AutomationProperties.Name="提示词模板列表">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="translation:PromptProfile">
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
              <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Classes="section" Text="{Binding ProfileName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted" Text="{Binding PromptKind}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Content="创建副本" Command="{Binding CopyPromptCommand}" />
                <Button x:Name="MorePromptButton" Content="更多" IsVisible="{Binding !IsBuiltInPrompt}" IsEnabled="{Binding CanManagePrompts}">
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem x:Name="DeletePromptMenuItem" Header="删除提示词" Command="{Binding DeletePromptCommand}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </Grid>
            <TabControl x:Name="PromptEditorTabs" Grid.Row="1" SelectedIndex="{Binding PromptSectionIndex}">
              <TabItem Header="正文">
                <Grid RowDefinitions="Auto,Auto,*,Auto,1.5*,Auto">
                  <Button x:Name="PromptVariablesButton" Content="变量说明" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <Button.Flyout>
                      <Flyout Placement="Bottom">
                        <ScrollViewer MaxHeight="260" MaxWidth="480" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="8">
                          <TextBlock Classes="muted" Text="{Binding PromptVariableHint}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="可用变量" />
                      <TextBlock Grid.Column="1" Classes="muted" Text="{Binding PromptVariableStatus}" AutomationProperties.LiveSetting="Polite" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl x:Name="PromptVariableList" ItemsSource="{Binding PromptVariables}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PromptVariableItem">
                          <Button x:Name="VariableButton" Classes="prompt-variable" CommandParameter="{Binding .}"
                                  Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CopyPromptVariableCommand}"
                                  AutomationProperties.Name="{Binding CopyLabel}" AutomationProperties.HelpText="{Binding Description}"
                                  GotFocus="OnPromptVariableGotFocus" LostFocus="OnPromptVariableLostFocus" KeyDown="OnPromptVariableKeyDown">
                            <TextBlock Text="{Binding Placeholder}" />
                            <ToolTip.Tip>
                              <StackPanel DataContext="{Binding #VariableButton.((vm:PromptVariableItem)DataContext)}" MaxWidth="360" Spacing="6">
                                <TextBlock Text="{Binding Placeholder}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" Text="点击复制完整占位符。" />
                              </StackPanel>
                            </ToolTip.Tip>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        </StackPanel>
                        </ScrollViewer>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <TextBlock Grid.Row="1" Text="系统提示词" Margin="0,0,0,4" />
                  <TextBox x:Name="PromptSystemEditor" Grid.Row="2" Text="{Binding SystemTemplate}" IsReadOnly="{Binding !CanEditPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="系统提示词" />
                  <TextBlock Grid.Row="3" Text="用户提示词模板" Margin="0,8,0,4" />
                  <TextBox x:Name="PromptUserEditor" Grid.Row="4" Text="{Binding UserTemplate}" IsReadOnly="{Binding !CanEditPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" AutomationProperties.Name="用户提示词模板" />
                  <TextBlock Grid.Row="5" Classes="error" Text="{Binding PromptContentError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </Grid>
              </TabItem>
              <TabItem Header="模板设置">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="10">
                    <TextBlock Text="模板名称" />
                    <TextBox x:Name="PromptNameEditor" Text="{Binding ProfileName}" IsReadOnly="{Binding !CanEditPrompt}" AutomationProperties.Name="模板名称" />
                    <TextBlock Classes="error" Text="{Binding PromptNameError}" TextWrapping="Wrap" />
                    <TextBlock Text="说明" />
                    <TextBox Text="{Binding PromptDescription}" IsReadOnly="{Binding !CanEditPrompt}" TextWrapping="Wrap" AutomationProperties.Name="模板说明" />
                    <CheckBox x:Name="BatchTranslationToggle" Content="批量翻译" IsChecked="{Binding BatchTranslation}" IsEnabled="{Binding CanEditPrompt}" />
                    <StackPanel IsVisible="{Binding BatchTranslation}" IsEnabled="{Binding CanEditPrompt}" Spacing="8">
                      <TextBlock Text="每批字幕条数上限" />
                      <NumericUpDown Value="{Binding PromptBatchSize}" Minimum="1" Maximum="100" AutomationProperties.Name="每批字幕条数上限" />
                      <TextBlock Text="每批字符上限" />
                      <NumericUpDown Value="{Binding PromptMaximumBatchCharacters}" Minimum="100" Maximum="50000" AutomationProperties.Name="每批字符上限" />
                    </StackPanel>
                    <TextBlock Classes="muted" Text="{Binding PromptVariableHint}" TextWrapping="Wrap" />
                    <Expander Header="模板使用情况">
                      <TextBlock Classes="muted" Text="{Binding PromptReferences}" TextWrapping="Wrap" />
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="提示词预览">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,1.5*">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Classes="muted" Text="样例：英语 → 中文。预览使用当前草稿，不调用模型。" TextWrapping="Wrap" Margin="0,0,12,0" />
                    <Button x:Name="CopyPromptPreviewButton" Grid.Column="1" Content="复制预览" Command="{Binding CopyPromptPreviewCommand}" />
                  </Grid>
                  <StackPanel Grid.Row="1">
                    <TextBlock Classes="error" Text="{Binding PromptPreviewError}" IsVisible="{Binding HasPromptPreviewError}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding PromptPreviewStatus}" IsVisible="{Binding HasPromptPreviewStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                  <TextBlock Grid.Row="2" Text="系统消息" Margin="0,0,0,4" />
                  <TextBox x:Name="PromptSystemPreviewBox" Grid.Row="3" Text="{Binding PromptSystemPreview}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="系统消息预览" />
                  <TextBlock Grid.Row="4" Text="用户消息" Margin="0,8,0,4" />
                  <TextBox x:Name="PromptUserPreviewBox" Grid.Row="5" Text="{Binding PromptUserPreview}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" AutomationProperties.Name="用户消息预览" />
                </Grid>
              </TabItem>
            </TabControl>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="常规">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Classes="settings-form" Spacing="10" IsEnabled="{Binding CanConfigure}">
            <TextBlock Classes="section" Text="主密码与密钥" />
            <views:CredentialStatusView />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="更换主密码" Command="{Binding ChangeMasterPasswordCommand}" />
              <Button Content="重置凭证" Command="{Binding ResetCredentialsCommand}" />
            </StackPanel>
            <TextBlock Classes="section" Text="外观" />
            <TextBlock Text="主题" />
            <ComboBox AutomationProperties.Name="外观主题" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding Settings.Theme}" HorizontalAlignment="Stretch" />
            <CheckBox Content="减少动画" IsChecked="{Binding Settings.ReduceMotion}" />
            <TextBlock Classes="section" Text="新任务的默认选项" />
            <TextBlock Text="源语言" />
            <ComboBox SelectedItem="{Binding DefaultSourceLanguage}" ItemsSource="{Binding SourceLanguageNames}" HorizontalAlignment="Stretch" AutomationProperties.Name="默认源语言" />
            <TextBlock Text="目标语言" />
            <TextBox Text="{Binding Settings.TargetLanguage}" AutomationProperties.Name="默认目标语言" />
            <TextBlock Classes="muted" Text="新任务会使用这些语言，也可在第二步直接调整。翻译引擎默认使用翻译服务页保存的选择。" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="3">
      <views:PreparationStatusView x:Name="SettingsPreparation" />
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Classes="muted" Text="{Binding SettingsFooterStatus}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        <Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Margin="0,0,12,0" />
        <Button x:Name="SettingsSaveButton" Grid.Column="2" Content="保存设置" Command="{Binding SaveSettingsCommand}" Classes="accent" />
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>

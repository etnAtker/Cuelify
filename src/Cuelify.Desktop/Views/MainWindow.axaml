<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Cuelify.Desktop.ViewModels" xmlns:views="using:Cuelify.Desktop.Views" x:Class="Cuelify.Desktop.Views.MainWindow" x:DataType="vm:MainWindowViewModel" Title="Cuelify" Width="1240" Height="828" MinWidth="900" MinHeight="608">
  <Grid ColumnDefinitions="80,*" RowDefinitions="*,Auto">
    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="8,20,8,16">
        <TextBlock Text="C" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" Margin="0,0,0,28" AutomationProperties.Name="Cuelify" />
        <Button x:Name="WorkspaceNavigation" Grid.Row="1" Classes="navigation" Classes.current="{Binding IsProjectNavigation}" Command="{Binding ShowProjectsCommand}" AutomationProperties.Name="项目" ToolTip.Tip="项目">
          <StackPanel Spacing="6"><PathIcon Data="{StaticResource Icon.Workspace}" Width="20" Height="20" /><TextBlock Text="项目" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
        </Button>
        <Button Grid.Row="2" Classes="navigation" Classes.current="{Binding IsLogs}" Command="{Binding ShowLogsCommand}" AutomationProperties.Name="日志" ToolTip.Tip="日志" Margin="0,8,0,0">
          <StackPanel Spacing="6"><PathIcon Data="{StaticResource Icon.Logs}" Width="20" Height="20" /><TextBlock Text="日志" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
        </Button>
        <Button Grid.Row="4" Classes="navigation" Classes.current="{Binding IsSettings}" Command="{Binding ShowSettingsCommand}" AutomationProperties.Name="设置" ToolTip.Tip="设置">
          <StackPanel Spacing="6"><PathIcon Data="{StaticResource Icon.Settings}" Width="20" Height="20" /><TextBlock Text="设置" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
        </Button>
      </Grid>
    </Border>
    <Grid Grid.Column="1" IsEnabled="{Binding !Workspace.HasDialog}">
      <views:ProjectsView x:Name="ProjectsPage" IsVisible="{Binding IsProjects}" />
      <views:WorkspaceView x:Name="WorkspacePage" IsVisible="{Binding IsWorkspace}" />
      <views:LogsView x:Name="LogsPage" IsVisible="{Binding IsLogs}" />
      <views:SettingsView x:Name="SettingsPage" IsVisible="{Binding IsSettings}" />
    </Grid>
    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="20,8" IsVisible="{Binding Activity.IsVisible}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock x:Name="ActiveProgressMessage" Text="{Binding Activity.Message}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Grid.Column="1" Text="{Binding Activity.Elapsed}" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Grid.Column="2" Content="查看媒体" Command="{Binding ViewActiveMediaCommand}" IsVisible="{Binding IsProcessing}" />
        <Button Grid.Column="2" Content="查看设置" Command="{Binding ShowSettingsCommand}" IsVisible="{Binding ShowActivitySettings}" />
        <Button Grid.Column="3" Content="停止" Command="{Binding CancelCommand}" IsVisible="{Binding Activity.CanCancel}" Margin="8,0,0,0" />
        <TextBlock x:Name="ActiveProgressCount" Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Activity.CountText}" IsVisible="{Binding Activity.HasCount}" TextWrapping="Wrap" Classes="muted" />
        <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Text="{Binding Activity.ExtraText}" IsVisible="{Binding Activity.HasExtra}" TextWrapping="Wrap" Classes="muted" />
        <ProgressBar x:Name="ActiveProgressBar" Grid.Row="3" Grid.ColumnSpan="4" Classes="operation-progress" IsIndeterminate="{Binding Activity.IsIndeterminate}" Value="{Binding Activity.BarValue}" Maximum="100" Margin="0,4,0,0" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="20,8" Background="{DynamicResource Brush.Surface}" IsVisible="{Binding HasPendingRun}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding PendingRunDescription}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="取消待处理操作" Command="{Binding CancelPendingRunCommand}" /></Grid></Border>
    <views:WorkspaceDialogView Grid.RowSpan="2" Grid.ColumnSpan="2" IsVisible="{Binding HasDialog}" DataContext="{Binding Workspace}" />
  </Grid>
</Window>

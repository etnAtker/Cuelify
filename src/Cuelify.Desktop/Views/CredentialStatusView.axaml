<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Cuelify.Desktop.ViewModels"
             x:Class="Cuelify.Desktop.Views.CredentialStatusView" x:DataType="vm:MainWindowViewModel">
  <StackPanel Spacing="8">
    <TextBlock Classes="muted" Text="{Binding CredentialHint}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="{Binding CredentialActionText}" Command="{Binding ManageMasterPasswordCommand}" IsVisible="{Binding !IsUnlocked}" />
      <Button Content="锁定" Command="{Binding LockCredentialsCommand}" IsVisible="{Binding IsUnlocked}" />
      <Button Content="保存密钥" Command="{Binding SaveCredentialsCommand}" IsVisible="{Binding IsUnlocked}" />
    </StackPanel>
    <TextBlock Classes="muted" Text="{Binding CredentialStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</UserControl>

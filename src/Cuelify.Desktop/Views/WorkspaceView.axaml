<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Cuelify.Desktop.ViewModels" xmlns:views="using:Cuelify.Desktop.Views" x:Class="Cuelify.Desktop.Views.WorkspaceView" x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,*" Margin="20,16,20,12">
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
      <Button Content="‹ 项目" Command="{Binding ShowProjectsCommand}" Margin="0,0,12,0" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding SelectedProject.Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Classes="muted" Text="{Binding ProjectSummary}" FontSize="12" /></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <Button Content="添加媒体…" Command="{Binding AddMediaCommand}" /><Button Content="批量处理…" Command="{Binding Workspace.BatchCommand}" IsEnabled="{Binding CanBatch}" />
        <Button Content="重命名" Command="{Binding Workspace.RenameCommand}" IsEnabled="{Binding CanManageProject}" />
      </StackPanel>
    </Grid>
    <Grid x:Name="MediaColumns" Grid.Row="1" ColumnDefinitions="190,5,*">
      <Border Background="{DynamicResource Brush.Surface}" CornerRadius="8" Padding="8">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Text="媒体" FontWeight="SemiBold" Margin="8,2,0,8" />
          <ListBox x:Name="MediaList" Grid.Row="1" ItemsSource="{Binding MediaTasks}" SelectedItem="{Binding SelectedMedia}" Background="Transparent" AutomationProperties.Name="媒体列表">
            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:MediaTaskItem"><Grid ColumnDefinitions="Auto,*" Margin="0,6"><CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" AutomationProperties.Name="加入批量范围" /><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="{Binding Detail}" FontSize="12" /><TextBlock Text="{Binding StatusText}" FontSize="12" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Spacing="6" Margin="0,6,0,0"><Button Content="继续批量处理…" Command="{Binding Workspace.ResumeBatchCommand}" IsVisible="{Binding Workspace.HasInterruptedBatch}" IsEnabled="{Binding CanManageProject}" /><Button Content="撤销删除" Command="{Binding Workspace.UndoRemoveCommand}" IsVisible="{Binding Workspace.HasRemovedMedia}" IsEnabled="{Binding CanManageProject}" /></StackPanel>
        </Grid>
      </Border>
      <GridSplitter x:Name="MediaSplitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />
      <Grid Grid.Column="2" Margin="16,0,0,0" RowDefinitions="Auto,Auto,*" IsVisible="{Binding HasMedia}">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <StackPanel Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding InputPath}" /><TextBlock Text="{Binding CurrentMediaSettings}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Button x:Name="MediaSettingsButton" Content="处理设置…" Command="{Binding Workspace.SettingsCommand}" IsEnabled="{Binding CanConfigure}" /><Button Content="重新定位文件…" Command="{Binding Workspace.LocateCommand}" IsEnabled="{Binding CanManageProject}" /><Button Content="删除" Foreground="{DynamicResource Brush.Error}" Command="{Binding Workspace.RemoveCommand}" IsEnabled="{Binding CanManageProject}" /></StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="源文件未找到" Classes="error" IsVisible="{Binding Workspace.SourceMissing}" Margin="0,0,0,8" />
        <views:WorkspaceResultsView x:Name="Results" Grid.Row="2" DataContext="{Binding Workspace}" />
      </Grid>
      <StackPanel Grid.Column="2" IsVisible="{Binding !HasMedia}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><TextBlock Text="添加第一个媒体" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="选择音频或视频，也可以拖入文件。" Classes="muted" /><Button Content="添加媒体…" Command="{Binding AddMediaCommand}" Classes="accent" HorizontalAlignment="Center" /></StackPanel>
    </Grid>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Cuelify.Desktop.ViewModels" xmlns:views="using:Cuelify.Desktop.Views" x:Class="Cuelify.Desktop.Views.PreparationStatusView" x:DataType="vm:MainWindowViewModel">
  <StackPanel IsVisible="{Binding IsPreparing}"><views:ProgressStatusView DataContext="{Binding Activity}" /></StackPanel>
</UserControl>

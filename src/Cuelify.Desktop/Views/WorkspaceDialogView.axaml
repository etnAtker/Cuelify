<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Cuelify.Desktop.ViewModels" xmlns:pipeline="using:Cuelify.Core.Translation" x:Class="Cuelify.Desktop.Views.WorkspaceDialogView" x:DataType="vm:ProjectWorkspaceViewModel">
  <UserControl.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding CloseDialogCommand}" /></UserControl.KeyBindings>
  <Border Background="#77000000"><Border Classes="surface" Padding="24" Width="600" MaxHeight="540" HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle" Focusable="True" x:Name="DialogPanel">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12"><TextBlock Text="{Binding DialogTitle}" FontSize="22" FontWeight="SemiBold" /><Button Grid.Column="1" Content="×" Command="{Binding CloseDialogCommand}" AutomationProperties.Name="关闭" /></Grid>
      <TextBlock Grid.Row="1" Text="{Binding DialogMediaName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" IsVisible="{Binding !NameDialog}" />
      <Grid Grid.Row="2">
        <StackPanel IsVisible="{Binding NameDialog}" Spacing="8"><TextBlock Text="项目名称" /><TextBox x:Name="ProjectNameInput" Text="{Binding NameDraft}" Watermark="填写项目名称" AutomationProperties.Name="项目名称" /></StackPanel>
        <StackPanel IsVisible="{Binding SettingsDialog}" Spacing="8"><TextBlock Text="{Binding DialogText}" Classes="muted" /><Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto"><TextBlock Text="源语言" /><ComboBox Grid.Row="1" ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding SourceDraft}" HorizontalAlignment="Stretch" /><TextBlock Grid.Column="2" Text="目标语言" /><TextBox Grid.Column="2" Grid.Row="1" Text="{Binding TargetDraft}" /></Grid><TextBlock Text="字幕管线" /><ComboBox x:Name="MediaPipelineSelector" ItemsSource="{Binding Pipelines}" SelectedItem="{Binding PipelineDraft}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="pipeline:SubtitlePipelineProfile"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
        <Grid IsVisible="{Binding BatchDialog}" RowDefinitions="Auto,Auto,Auto,*,Auto"><CheckBox Content="只重试失败部分" IsChecked="{Binding BatchFailedOnly}" /><CheckBox Grid.Row="1" Content="保留本批次原处理设置" IsChecked="{Binding KeepResumeSettings}" IsVisible="{Binding ResumeBatch}" Margin="0,4,0,0" /><TextBlock Grid.Row="2" Text="{Binding BatchSummary}" FontWeight="SemiBold" Margin="0,8" /><ListBox x:Name="BatchPreviewList" Grid.Row="3" ItemsSource="{Binding BatchRows}" MaxHeight="220" MinHeight="60" AutomationProperties.Name="批量处理范围"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:BatchPreviewRow"><StackPanel Margin="0,4" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Settings}" Classes="muted" FontSize="12" /><TextBlock Text="{Binding Plan}" FontSize="12" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="4" Text="{Binding DialogText}" Classes="muted" FontSize="12" Margin="0,8,0,0" /></Grid>
      </Grid>
      <TextBlock Grid.Row="3" Text="{Binding DialogError}" Classes="error" Margin="0,8,0,0" />
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0"><Button Content="取消" Command="{Binding CloseDialogCommand}" /><Button x:Name="ConfirmWorkspaceDialog" Content="{Binding SubmitText}" Command="{Binding SubmitDialogCommand}" IsEnabled="{Binding CanSubmit}" Classes="accent" /></StackPanel>
    </Grid>
  </Border></Border>
</UserControl>

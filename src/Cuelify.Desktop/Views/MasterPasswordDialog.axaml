<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Cuelify.Desktop.ViewModels"
        x:Class="Cuelify.Desktop.Views.MasterPasswordDialog" x:DataType="vm:MasterPasswordViewModel"
        Title="{Binding Title}" Width="440" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Classes="section" Text="{Binding Title}" />
    <StackPanel Spacing="8" IsEnabled="{Binding CanEdit}">
      <StackPanel IsVisible="{Binding IsChange}" Spacing="8">
        <TextBlock Text="当前主密码" />
        <TextBox x:Name="CurrentPasswordBox" Text="{Binding CurrentPassword}" PasswordChar="{Binding PasswordChar}" AutomationProperties.Name="当前主密码" />
      </StackPanel>
      <TextBlock Text="{Binding PasswordLabel}" />
      <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="{Binding PasswordChar}" AutomationProperties.Name="{Binding PasswordLabel}" />
      <StackPanel IsVisible="{Binding NeedsConfirmation}" Spacing="8">
        <TextBlock Text="确认主密码" />
        <TextBox Text="{Binding Confirmation}" PasswordChar="{Binding PasswordChar}" AutomationProperties.Name="确认主密码" />
        <TextBlock Classes="muted" Text="忘记主密码后，需要重置并重新填写密钥。" TextWrapping="Wrap" />
      </StackPanel>
      <CheckBox Content="显示密码" IsChecked="{Binding ShowPassword}" />
    </StackPanel>
    <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
      <Button Content="取消" Command="{Binding CancelCommand}" />
      <Button Content="{Binding SubmitText}" Command="{Binding SubmitCommand}" Classes="accent" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
